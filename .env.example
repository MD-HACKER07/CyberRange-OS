# ---------------------------------------------------------------------------
# CyberRange OS — environment configuration
# Copy to .env and adjust for your lab. NEVER commit the real .env.
# ---------------------------------------------------------------------------

APP_ENV=development
HTTP_ADDR=:8080
PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info

# --- Postgres (pgvector) ---
DATABASE_URL=postgres://cyberrange:cyberrange@postgres:5432/cyberrange?sslmode=disable

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# --- Auth ---
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
COOKIE_DOMAIN=
COOKIE_SECURE=false
ALLOW_LOCAL_PASSWORD=true
# Institution SSO (OIDC). Leave blank to disable.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:8080/api/auth/sso/callback
SAML_METADATA_URL=

# --- Local LLM runtime (Ollama / vLLM / TGI) — NEVER a cloud API ---
# Must resolve to a private/loopback address or the gateway refuses to start.
LLM_BASE_URL=http://ollama:11434
LLM_DEFAULT_MODEL=llama3.1:8b
LLM_EMBED_MODEL=nomic-embed-text
LLM_REQUEST_TIMEOUT=120s
LLM_ALLOW_PUBLIC_IP=false
LLM_SESSION_TOKEN_CAP=120000

# --- Range orchestration ---
RANGE_DRIVER=docker
# Linux lab host (default). On Windows dev, use tcp://localhost:2375.
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_API_VERSION=v1.43
RANGE_KALI_IMAGE=cyberrange/kali-attacker:latest
RANGE_SUBNET_PREFIX=10.66
RANGE_SESSION_MAX_MINUTES=180
RANGE_CPU_QUOTA=2.0
RANGE_MEMORY_MB=2048
# Proxmox (production VM isolation) — optional
PROXMOX_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_NODE=pve

# --- SIEM / IDS ---
WAZUH_URL=https://wazuh-manager:55000
WAZUH_USER=wazuh
WAZUH_PASSWORD=
WAZUH_VERIFY_TLS=false
SURICATA_EVE_FILE=/var/log/suricata/eve.json
INGEST_POLL_SECONDS=5

# --- AI red-teaming tooling ---
PYRIT_COMMAND=python -m pyrit_runner
GARAK_COMMAND=garak

# --- Reporting ---
PDF_RENDERER=chromium
PDF_BINARY=chromium
STORAGE_DIR=/data/storage

# --- Attainment (must sum to 1.0) ---
ATTAINMENT_DIRECT_WEIGHT=0.8
ATTAINMENT_INDIRECT_WEIGHT=0.2

# --- Observability ---
METRICS_ENABLED=true

# --- Seed bootstrap ---
SEED_ADMIN_EMAIL=admin@cyberrange.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Lab Admin
# Optional: point at the full MITRE ATT&CK enterprise STIX bundle for full coverage
MITRE_STIX_PATH=

# --- Frontend ---
NEXT_PUBLIC_API_BASE=http://localhost:8080
