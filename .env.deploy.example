# CyberRange OS — server deployment env.
# Copy to .env.deploy on the Ubuntu box and fill in real values.
#   cp .env.deploy.example .env.deploy && nano .env.deploy

# Postgres password for the platform database (compose creates this DB).
POSTGRES_PASSWORD=change-this-strong-db-pass

# JWT signing secret. Generate: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret

# Public URL students hit in the browser (this server's LAN IP + web port).
PUBLIC_URL=http://3.80.28.130:3000

# Local LLM (native Ollama already running on the host). Leave as-is to reuse it.
LLM_BASE_URL=http://host.docker.internal:11434
# General-purpose model used for pentest-copilot, red-teaming-target,
# mitre-tagging, report-grading, assistant.
LLM_DEFAULT_MODEL=llama3.2:3b
# Optional: a specialized fine-tune scoped ONLY to soc-copilot. Leave blank
# to use LLM_DEFAULT_MODEL for every module.
LLM_SOC_MODEL=cyberrange-sec
LLM_EMBED_MODEL=nomic-embed-text

# First Lab Admin account (created on first boot).
SEED_ADMIN_EMAIL=admin@cyberrange.local
SEED_ADMIN_PASSWORD=change-this-admin-pass
SEED_ADMIN_NAME=Lab Admin
